#!/bin/sh
# omp-reviewer-kit hook v0.20.0 body-sha256:8f92aac0641246e2b3682d2be130fc9a76ef25b014fe69972ccb8144470a01d8
set -eu

hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(CDPATH= cd -- "$hook_dir/.." && pwd)

# Kit repository (package name omp-reviewer-kit): run the canonical runner in scripts/ directly,
# so a stale copy that a session-start plugin update left under .omp/review-kit/ is never executed.
# Consumer repositories run their vendored copy as installed; the installer keeps that copy current.
if [ -f "$root/package.json" ] \
  && [ -f "$root/scripts/run-review.mjs" ] \
  && node -e 'try { process.exit(JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")).name === "omp-reviewer-kit" ? 0 : 1); } catch { process.exit(1); }' "$root/package.json" 2>/dev/null; then
  exec node "$root/scripts/run-review.mjs"
fi

exec node "$root/.omp/review-kit/run-review.mjs"
