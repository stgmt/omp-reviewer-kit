{
  "name": "omp-reviewer-kit",
  "version": "0.30.0",
  "private": true,
  "description": "Multi-stage OMP review system and Git pre-commit hook for evidence-first code review.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/stgmt/omp-reviewer-kit",
  "repository": {
    "type": "git",
    "url": "https://github.com/stgmt/omp-reviewer-kit.git"
  },
  "engines": {
    "node": ">=18.0.0",
    "opencode": ">=1.19.0"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./runner": "./scripts/run-review.mjs",
    "./extension": "./src/extension.mjs",
    "./server": "./opencode/plugin.mjs"
  },
  "files": [
    "scripts",
    "templates",
    "agents",
    "skills",
    "src",
    "opencode",
    "claude-plugin",
    ".claude-plugin",
    ".codex-plugin",
    ".agents",
    "bun.lock",
    ".omp-plugin",
    "ROADMAP.md",
    "CHANGELOG.md"
  ],
  "omp": {
    "name": "omp-reviewer-kit",
    "version": "0.30.0",
    "extensions": [
      "./src/extension.mjs"
    ]
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "test:mutation": "node scripts/run-mutation-tests.mjs",
    "check": "node scripts/check-layout.mjs"
  },
  "dependencies": {
    "@babel/parser": "7.29.9",
    "@oh-my-pi/pi-coding-agent": "18.12.5",
    "zod": "4.1.8"
  }
}
